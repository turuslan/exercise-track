    "better-sqlite3": "^12.11.1",
    "date-fns": "^4.4.0",
    "ink": "^7.1.0",
    "ink-text-input": "^6.0.0",
    "koa": "^3.2.1",
    "mdns": "^2.7.2",
    "react": "^19.2.7",
    "typeorm": "^1.0.0"
  },
  "devDependencies": {
    "@types/koa": "^3.0.3",
    "@types/mdns": "^0.0.38",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "tsx": "^4.22.4"
  }
}
